{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yoru",
  "mainBinaryName": "yoru",
  "version": "0.5.0",
  "identifier": "dev.yoru.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yoru — SSH & Server Manager",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "visible": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "yoru",
    "copyright": "yoru",
    "category": "DeveloperTool",
    "shortDescription": "Yoru — SSH & Server Manager",
    "longDescription": "A calm, local-first SSH client and server manager for Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBODczREVFQUE2RUY1MEYKUldRUDlXNnE3ajJIMm1lTnc4SW5NS0w5WUhOUlNZM3JFRTlQS2ljaWRkelRKMGhMd2hEOGp4blgK",
      "endpoints": [
        "https://github.com/sundeiii/waga/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
